# Department Timetable Solver Service - Environment Configuration
# Works seamlessly on Render Free Tier and Google Cloud Run

# Environment mode: 'development' or 'production'
# In 'production', SOLVER_API_KEY is strictly required and the service fails closed if missing.
ENVIRONMENT=production

# Shared Secret Key used to authenticate calling clients (Node.js backend / Render callers)
# Generate a random 32 or 64 character hex string (e.g. `openssl rand -hex 32`)
SOLVER_API_KEY=replace-with-a-secure-random-64-character-hex-string

# HTTP Host and Port (Render automatically sets PORT=10000; Cloud Run sets PORT=8080)
HOST=0.0.0.0
PORT=10000

# Worker concurrency for lightweight container environments (defaults to 1-2 workers for 512MB RAM)
WEB_CONCURRENCY=1
MAX_SOLVER_WORKERS=2
