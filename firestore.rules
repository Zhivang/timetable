rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'shivangshukla884@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isRegisteredAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isBootstrappedAdmin() || isRegisteredAdmin();
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // Academic Settings
    match /academicSettings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(settingId) && isAdmin();
    }

    // Buildings
    match /buildings/{buildingId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(buildingId) && isAdmin();
    }

    // Classrooms
    match /classrooms/{classroomId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(classroomId) && isAdmin();
    }

    // Student Cohorts
    match /cohorts/{cohortId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(cohortId) && isAdmin();
    }

    // Combined Classes
    match /combinedClasses/{combinedClassId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(combinedClassId) && isAdmin();
    }

    // Teachers
    match /teachers/{teacherId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(teacherId) && isAdmin();
    }

    // Subject Offerings
    match /subjectOfferings/{subjectOfferingId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(subjectOfferingId) && isAdmin();
    }

    // Scheduling Preferences
    match /schedulingPreferences/{prefId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(prefId) && isAdmin();
    }

    // Timetable Runs
    match /timetableRuns/{runId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(runId) && isAdmin();
    }
  }
}
